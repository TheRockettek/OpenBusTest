{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang Release",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build-ode",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "OPENBUS_BUILD_BGFX_LIGHTING_PROBE": "OFF"
      },
      "environment": {
        "PATH": "C:/Program Files/LLVM/bin;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64;$penv{PATH}",
        "INCLUDE": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/include;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um",
        "LIB": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/ucrt/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64"
      }
    },
    {
      "name": "windows-clang-benchmark",
      "displayName": "Windows Clang Release (Benchmark Tracing)",
      "inherits": "windows-clang-release",
      "binaryDir": "${sourceDir}/build-benchmark",
      "cacheVariables": {
        "OPENBUS_ENABLE_PERF_TRACE": "ON"
      }
    },
    {
      "name": "windows-clang-bgfx",
      "displayName": "Windows Clang Release (bgfx Lighting Probe)",
      "inherits": "windows-clang-release",
      "binaryDir": "${sourceDir}/build-bgfx",
      "cacheVariables": {
        "OPENBUS_BUILD_BGFX_LIGHTING_PROBE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" },
    { "name": "windows-clang-benchmark", "configurePreset": "windows-clang-benchmark" },
    { "name": "windows-clang-bgfx", "configurePreset": "windows-clang-bgfx" }
  ],
  "testPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "output": { "outputOnFailure": true } }
  ]
}