{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{OPENBUS_CLANG_COMPILER}",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{OPENBUS_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "OPENBUS_ENABLE_PERF_TRACE": "ON",
        "OPENBUS_BUILD_BGFX_LIGHTING_PROBE": "OFF"
      },
      "environment": {
        "PATH": "$env{OPENBUS_CLANG_BIN};$env{OPENBUS_NINJA_BIN};$env{OPENBUS_MSVC_ROOT}/bin/Hostx64/x64;$penv{PATH}",
        "INCLUDE": "$env{OPENBUS_MSVC_ROOT}/include;$env{OPENBUS_WINDOWS_KIT}/Include/$env{OPENBUS_WINDOWS_KIT_VERSION}/ucrt;$env{OPENBUS_WINDOWS_KIT}/Include/$env{OPENBUS_WINDOWS_KIT_VERSION}/shared;$env{OPENBUS_WINDOWS_KIT}/Include/$env{OPENBUS_WINDOWS_KIT_VERSION}/um",
        "LIB": "$env{OPENBUS_MSVC_ROOT}/lib/x64;$env{OPENBUS_WINDOWS_KIT}/Lib/$env{OPENBUS_WINDOWS_KIT_VERSION}/ucrt/x64;$env{OPENBUS_WINDOWS_KIT}/Lib/$env{OPENBUS_WINDOWS_KIT_VERSION}/um/x64"
      }
    },
    {
      "name": "windows-clang-ninja",
      "displayName": "Windows Clang Release (Ninja, parallel)",
      "inherits": "windows-clang-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "$env{OPENBUS_NINJA}",
        "OPENBUS_ENABLE_PERF_TRACE": "OFF"
      }
    },
    {
      "name": "windows-clang-benchmark",
      "displayName": "Windows Clang Release (Benchmark Tracing)",
      "inherits": "windows-clang-release",
      "binaryDir": "${sourceDir}/build-benchmark-ninja",
      "cacheVariables": {
        "OPENBUS_ENABLE_PERF_TRACE": "ON"
      }
    },
    {
      "name": "windows-clang-bgfx",
      "displayName": "Windows Clang Release (bgfx Lighting Probe)",
      "inherits": "windows-clang-release",
      "binaryDir": "${sourceDir}/build-bgfx",
      "cacheVariables": {
        "OPENBUS_BUILD_BGFX_LIGHTING_PROBE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "jobs": 12 },
    { "name": "windows-clang-ninja", "configurePreset": "windows-clang-ninja", "jobs": 12 },
    { "name": "windows-clang-benchmark", "configurePreset": "windows-clang-benchmark" },
    { "name": "windows-clang-bgfx", "configurePreset": "windows-clang-bgfx" }
  ],
  "testPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-ninja", "configurePreset": "windows-clang-ninja", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-benchmark", "configurePreset": "windows-clang-benchmark", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-bgfx", "configurePreset": "windows-clang-bgfx", "output": { "outputOnFailure": true } }
  ]
}